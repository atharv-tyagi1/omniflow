# ------------------------------------------------------------------------------
# OmniFlow Environment Configuration
# ------------------------------------------------------------------------------
# Backend Settings
# ------------------------------------------------------------------------------

# Database (Supabase PostgreSQL with pgvector)
# Must use the transaction connection pooler (port 6543) or direct connection (port 5432)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.ntpwefohvfdwygdolaqv.supabase.co:5432/postgres"

# Used by Alembic for synchronous migrations
SYNC_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.ntpwefohvfdwygdolaqv.supabase.co:5432/postgres"

# Supabase Admin
SUPABASE_URL="https://ntpwefohvfdwygdolaqv.supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# API Keys
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"
TELEGRAM_BOT_TOKEN="[YOUR-TELEGRAM-BOT-TOKEN]"

# JWT / Auth
JWT_SECRET="[YOUR-SECURE-RANDOM-JWT-SECRET]"

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="${SUPABASE_URL}"
NEXT_PUBLIC_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"
NEXT_PUBLIC_API_URL="http://localhost:8000"
